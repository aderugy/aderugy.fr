# Supabase — Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Timezone used to decide which week to open by default (server-side).
NEXT_PUBLIC_APP_TIMEZONE=Europe/Paris

# Google Calendar: the OAuth *client id* only. The client secret lives in
# Supabase Edge Function secrets and never reaches this app.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

# Claude connector (/api/mcp) — both optional.
# Issuer of Supabase's OAuth 2.1 server; defaults to $NEXT_PUBLIC_SUPABASE_URL/auth/v1.
# Set it only if Supabase advertises a different issuer (custom auth domain).
# SUPABASE_OAUTH_ISSUER=https://your-project.supabase.co/auth/v1
# The MCP URL exactly as entered in Claude; defaults to <request origin>/api/mcp.
# MCP_RESOURCE_URL=https://aderugy.fr/api/mcp

# Web Push (block reminders) — the public half of the VAPID pair from
# `node scripts/vapid-keys.mjs`. The private half is a Supabase secret only.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
